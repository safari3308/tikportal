# Docker Compose Image & Host Port
TIKPORTAL_IMAGE_TAG=latest
HOST_PORT=8080

# Server & Database
LISTEN_ADDR=:8080
BASE_URL=http://localhost:8080
DB_PATH=./data/tikportal.db
SESSION_SECRET=replace-with-a-random-32-byte-secret
DEFAULT_MAX_PEERS_PER_USER=5
ADMIN_EMAILS=admin@localhost

# MikroTik RouterOS v7 REST API
# Set ROUTEROS_MOCK=true for local development without a router
ROUTEROS_MOCK=false
ROUTEROS_URL=https://192.168.88.1
ROUTEROS_USER=tikportal-api
ROUTEROS_PASSWORD=your-routeros-password
ROUTEROS_INSECURE_SKIP_TLS_VERIFY=true
# Only allow RouterOS WireGuard interfaces whose comment contains this tag (set to * to allow all)
ROUTEROS_INTERFACE_TAG=tikportal
# Optional comma-separated allowlist of interface names (e.g. wg-main,wg-guest)
ROUTEROS_ALLOWED_INTERFACES=

# OIDC Provider (Zitadel, Keycloak, Authentik, etc.)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/api/auth/callback
OIDC_SCOPES=openid,profile,email
DEV_AUTH_ENABLED=true
